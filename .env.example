# ─────────────────────────────────────────────────────────────
# Studio Corte — variáveis de ambiente
# Copie este arquivo para ".env" e preencha. NUNCA versione o .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Neon → painel do projeto → "Connect" → copie as duas strings:
# Conexão COM pooler (host contém "-pooler"): usada pela aplicação
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/studio_corte?sslmode=require"
# Conexão DIRETA (sem "-pooler"): usada pelas migrations
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/studio_corte?sslmode=require"

# Segredo das sessões e do CSRF (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_DAYS=7

# Primeiro administrador (usado apenas pelo seed, uma vez)
SEED_ADMIN_NOME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=

# E-mail (recuperação de senha). Opcional em desenvolvimento:
# sem SMTP, o link de redefinição aparece no console do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Studio Corte <no-reply@seudominio.com>"

# Testes que gravam dados: uma BRANCH SEPARADA do Neon (nunca o banco principal).
# Neon → Branches → Create branch → Connect. Os testes se recusam a rodar se forem iguais às URLs acima.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
