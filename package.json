{
  "name": "studio-corte",
  "version": "1.0.0",
  "private": true,
  "description": "Studio Corte — sistema de barbearia (Express + Prisma + PostgreSQL/Neon)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev:teste": "node --watch --env-file=.env --env-file=.env.teste src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "test:db:prepare": "node --env-file-if-exists=.env scripts/preparar-banco-teste.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
